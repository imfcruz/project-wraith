# Crie .env a partir deste arquivo. Nunca versione o token real.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Use um servidor de desenvolvimento para registrar comandos instantaneamente.
DISCORD_GUILD_ID=

# Banco local do compose.yaml. Troque a senha no seu .env.
POSTGRES_USER=wraith
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=wraith
DATABASE_URL=postgresql://wraith:troque-esta-senha@localhost:5432/wraith

# Limite de conexões deste processo. Considere todas as instâncias na hospedagem.
DATABASE_POOL_MAX=10

# debug | info | warn | error
LOG_LEVEL=info
